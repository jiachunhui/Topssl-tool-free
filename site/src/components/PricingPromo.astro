---
// 首页促销价目版块：多年期 SSL 证书优惠价（Fluent 亚克力卡片风格）。
// 价格数据集中在 src/config.ts 的 PRICING，改动无需碰本组件。
import { PRICING } from '../config'
const fmt = (n: number) => '¥' + n.toFixed(2)
---
<section class="section section-glow pricing-section" id="pricing">
  <div class="container">
    <div class="section-head reveal">
      <span class="kicker">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z"/></svg>
        {PRICING.badge}
      </span>
      <h2>{PRICING.heading}</h2>
      <p>{PRICING.sub}</p>
    </div>

    <div class="pricing-grid">
      {PRICING.plans.map((p, i) => (
        <div class={'pricing-card reveal' + (p.highlight ? ' pricing-card-hot' : '')} style={"--reveal-delay:" + i * 0.1 + "s"}>
          {p.highlight && <span class="pricing-flag">最受欢迎</span>}
          <div class="pricing-head">
            <h3>{p.name}</h3>
            <span class="pricing-tag">{p.tag}</span>
          </div>
          <p class="pricing-desc">{p.desc}</p>
          <div class="pricing-price">
            <span class="pricing-cur">¥</span>
            <span class="pricing-num">{(p.priceValue)}</span>
            <span class="pricing-term">/ {p.priceTerm}</span>
            <span class="pricing-per">每年单价</span>
          </div>
          <div class="pricing-terms">
            {p.terms.map((t) => (
              <div class={'pricing-term-item' + (t.hot ? ' on' : '')}>
                <span class="term-name">{t.term}</span>
                <span class="term-price">
                  {fmt(t.value)}<em>/年</em>
                </span>
                {t.hot && <span class="term-hot">最划算</span>}
              </div>
            ))}
          </div>
          <a class="btn btn-primary btn-block" href={p.url} target="_blank" rel="noopener">
            {p.cta}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
          </a>
        </div>
      ))}
    </div>

    <p class="pricing-note reveal">{PRICING.note}</p>
  </div>
</section>
