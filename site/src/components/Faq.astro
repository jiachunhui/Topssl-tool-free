---
import { FAQS } from '../config'
---
<section class="section" id="faq">
  <div class="container">
    <div class="section-head reveal">
      <span class="kicker">常见问题</span>
      <h2>你可能想知道</h2>
    </div>
    <div class="faq-list">
      {FAQS.map((f, i) => (
        <details class="faq-item reveal" style={"--reveal-delay:" + Math.min(i * 0.05, 0.3) + "s"}>
          <summary>{f.q}</summary>
          <div class="answer">{f.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>
