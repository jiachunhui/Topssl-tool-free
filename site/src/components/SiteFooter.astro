---
import { SITE, TOPSSL, GITHUB } from '../config'
const year = new Date().getFullYear()
---
<footer class="site-footer">
  <div class="container">
    <div class="grid">
      <div>
        <div class="brand-mark" style="color:#fff">{SITE.name}</div>
        <p style="margin-top:.7rem;max-width:26rem">
          {SITE.description}
        </p>
      </div>
      <div>
        <h4>项目</h4>
        <div style="display:grid;gap:.45rem">
          <a href="/download/">免费下载</a>
          <a href="/docs/quickstart/">使用教程</a>
          <a href="/changelog/">更新日志</a>
          <a href="/about/">关于与开源</a>
        </div>
      </div>
      <div>
        <h4>相关资源</h4>
        <div style="display:grid;gap:.45rem">
          <a href={TOPSSL.url('landing-footer')} target="_blank" rel="noopener">TopSSL 官网</a>
          <a href="https://letsencrypt.org/zh-cn/" target="_blank" rel="noopener">Let&rsquo;s Encrypt</a>
          <a href={GITHUB} target="_blank" rel="noopener noreferrer">GitHub 仓库</a>
          <a href={GITHUB + '/blob/main/LICENSE'} target="_blank" rel="noopener noreferrer">MIT 许可证</a>
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {year} {SITE.name} · 由 TopSSL 出品并支持 · 基于 MIT 协议开源</span>
      <span>本站为开源项目宣传页，与 Let&rsquo;s Encrypt 无隶属关系</span>
    </div>
  </div>
</footer>
