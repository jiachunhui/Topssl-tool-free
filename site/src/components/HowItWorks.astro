---
const steps = [
  { title: '输入域名', desc: '添加需要保护的网站域名，支持单域名、多域名和通配符域名。' },
  { title: '完成域名验证', desc: '根据网站环境选择HTTP验证或DNS验证，确认域名控制权限。' },
  { title: '自动签发与续期', desc: '证书签发后自动保存和管理，到期前自动续期。' },
]
---
<section class="section section-soft" id="how">
  <div class="container">
    <div class="section-head reveal">
      <span class="kicker">工作流程</span>
      <h2>三步完成免费SSL证书申请</h2>
      <p>全程可视化进度，从提交到签发约 1-3 分钟</p>
    </div>
    <div class="steps">
      {steps.map((s, i) => (
        <div class="step reveal" style={"--reveal-delay:" + i * 0.1 + "s"}>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
