---
import { TOPSSL, GITHUB } from '../config'
---
<section class="hero" id="top">
  <div class="container inner">
    <div>
      <span class="hero-badge">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5Z"/></svg>
        开源 · 免费 · 由 TopSSL 出品
      </span>
      <h1>免费 SSL 证书，<span class="grad">一键申请</span>，自动续期</h1>
      <p class="hero-sub">
        TopSSL 免费证书助手是一款跨平台桌面工具：输入域名，几分钟获得
        Let&rsquo;s Encrypt 免费证书并自动安装到本机，到期前 30 天自动续期，
        支持 HTTP / DNS 两种验证方式与通配符证书，一次配置长期无忧。
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={GITHUB} target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.25 10.25 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/></svg>
          免费下载
        </a>
        <a class="btn btn-ghost-dark" href={TOPSSL.url('landing-hero')} target="_blank" rel="noopener noreferrer">
          了解 TopSSL
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
        </a>
      </div>
      <p class="hero-note">支持 Windows · macOS · Linux ｜ 基于 MIT 协议开源</p>
    </div>
    <div class="terminal" aria-hidden="true">
      <div class="terminal-bar">
        <i></i><i></i><i></i><span>topssl-cert-assistant</span>
      </div>
      <pre class="terminal-body" id="terminal-lines"></pre>
    </div>
  </div>
</section>
<script>
  const LINES: Array<[string, string]> = [
    ['$ topssl-cert-assistant', 'dim'],
    ['→ 输入域名：example.com', ''],
    ['✓ 域名格式校验通过（HTTP-01）', 'ok'],
    ['→ 连接 Let&rsquo;s Encrypt 目录…', 'dim'],
    ['✓ ACME 账户注册成功', 'ok'],
    ['✓ 订单已创建（example.com）', 'ok'],
    ['→ 等待验证（80 端口临时服务）…', 'dim'],
    ['✓ 挑战验证通过', 'ok'],
    ['✓ 证书已签发并安装到本机', 'ok'],
    ['→ 自动续期已开启（到期前 30 天）', 'warn'],
    ['✓ 完成，全程约 1-3 分钟', 'brand'],
  ]
  const el = document.getElementById('terminal-lines')
  if (el) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reduce) {
      el.innerHTML = LINES.map(([t, c]) => `<div class="line ${c}">${t}</div>`).join('')
    } else {
      let i = 0
      const render = () => {
        if (i >= LINES.length) return
        const [text, cls] = LINES[i]
        el.innerHTML += `<div class="line ${cls}">${text}</div>`
        el.scrollTop = el.scrollHeight
        i++
        setTimeout(render, 480)
      }
      el.innerHTML = '<div class="line cursor"></div>'
      setTimeout(render, 400)
    }
  }
</script>
