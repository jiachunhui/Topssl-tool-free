---
import { TOPSSL, GITHUB } from '../config'
import { existsSync } from 'node:fs'

// 截图占位：优先使用真实截图（.png），不存在时回退到内置占位图（.svg）
// 后期替换方法：把真实截图命名为 certs-view.png 放入 site/public/screenshots/ 即可
const heroShotPng = '/screenshots/certs-view.png'
const heroShotSvg = '/screenshots/certs-view.svg'
const useReal = existsSync(new URL('../../public/screenshots/certs-view.png', import.meta.url))
const heroShot = useReal ? heroShotPng : heroShotSvg
---
<section class="hero" id="top">
  <div class="aurora a" aria-hidden="true"></div>
  <div class="aurora b" aria-hidden="true"></div>
  <div class="aurora c" aria-hidden="true"></div>
  <div class="container inner">
    <div>
      <span class="hero-badge">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5Z"/></svg>
        开源 · 免费 · 由 TopSSL 出品
      </span>
      <h1>免费SSL证书管理工具， <span class="grad">申请部署续期一站搞定</span></h1>
      <p class="hero-sub">
        Tossl是一款免费的SSL证书管理工具，支持Windows、macOS和Linux。输入域名即可申请Let&rsquo;s Encrypt免费SSL证书；一键导出部署包，Windows服务器可自动部署到IIS；到期前提醒并自动续期，让网站HTTPS配置与维护更加简单。
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/download/" target="_blank" rel="noopener noreferrer">
          免费下载
        </a>
        <a class="btn btn-ghost-dark" href="/docs/quickstart/" target="_blank" rel="noopener">
         查看使用教程
        </a>
      </div>
      <p class="hero-note">
       <span>✓ 免费开源</span> <span>✓ Let's Encrypt支持</span> <span>✓ HTTP/DNS验证</span> <span>✓ 通配符证书</span> <span>✓ 部署包与IIS部署</span> <span>✓ 到期提醒与续期</span>
      </p>
    </div>
    <div class="hero-shot" aria-label="Tossl 免费SSL证书申请与自动续期工具界面截图">
      <div class="shot-glow" aria-hidden="true"></div>
      <div class="window">
        <div class="window-bar" aria-hidden="true">
          <i></i><i></i><i></i>
          <span class="addr">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path stroke-linecap="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
            www.tossl.cn
          </span>
        </div>
        <img class="window-body" src={heroShot} alt="Tossl 免费SSL证书申请与自动续期工具「我的证书」界面" width="1280" height="800" loading="eager" fetchpriority="high" />
      </div>
      <span class="float-chip chip-1">
        <span class="dot-ok">✓</span> 证书已签发 · 自动续期中
      </span>
      <span class="float-chip chip-2">
        <span class="ring"></span> 剩余 82 天 · 到期自动续期
      </span>
    </div>
  </div>
</section>