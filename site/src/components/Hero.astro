---
import { TOPSSL, GITHUB } from '../config'
import { existsSync } from 'node:fs'

// 截图占位：优先使用真实截图（.png），不存在时回退到内置占位图（.svg）
// 后期替换方法：把真实截图命名为 certs-view.png 放入 site/public/screenshots/ 即可
const heroShotPng = '/screenshots/certs-view.png'
const heroShotSvg = '/screenshots/certs-view.svg'
const useReal = existsSync(new URL('../../public/screenshots/certs-view.png', import.meta.url))
const heroShot = useReal ? heroShotPng : heroShotSvg
---
<section class="hero" id="top">
  <div class="aurora a" aria-hidden="true"></div>
  <div class="aurora b" aria-hidden="true"></div>
  <div class="aurora c" aria-hidden="true"></div>
  <div class="container inner">
    <div>
      <span class="hero-badge">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5Z"/></svg>
        开源 · 免费 · 由 TopSSL 出品
      </span>
      <h1>免费 SSL 证书，<span class="grad">一键申请</span>，自动续期</h1>
      <p class="hero-sub">
        TopSSL 免费证书助手是一款跨平台桌面工具：输入域名，几分钟获得
        Let&rsquo;s Encrypt 免费证书并自动安装到本机，到期前 30 天自动续期，
        支持 HTTP / DNS 两种验证方式与通配符证书，一次配置长期无忧。
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={GITHUB} target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.25 10.25 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/></svg>
          免费下载
        </a>
        <a class="btn btn-ghost-dark" href={TOPSSL.url('landing-hero')} target="_blank" rel="noopener">
          了解 TopSSL
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
        </a>
      </div>
      <p class="hero-note">
        <span>支持 Windows · macOS · Linux</span>
        <span class="sep">|</span>
        <span>基于 MIT 协议开源</span>
        <span class="sep">|</span>
        <span>v0.1.3</span>
      </p>
    </div>
    <div class="hero-shot" aria-label="TopSSL 免费证书助手界面截图">
      <div class="shot-glow" aria-hidden="true"></div>
      <div class="window">
        <div class="window-bar" aria-hidden="true">
          <i></i><i></i><i></i>
          <span class="addr">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path stroke-linecap="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
            topssl-cert-assistant
          </span>
        </div>
        <img class="window-body" src={heroShot} alt="TopSSL 免费证书助手「我的证书」界面" width="1280" height="800" loading="eager" fetchpriority="high" />
      </div>
      <span class="float-chip chip-1">
        <span class="dot-ok">✓</span> 证书已签发 · 自动续期中
      </span>
      <span class="float-chip chip-2">
        <span class="ring"></span> 剩余 82 天 · 到期自动续期
      </span>
    </div>
  </div>
</section>