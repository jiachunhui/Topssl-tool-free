---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE, GITHUB } from '../config'

const title = '更新日志：TopSSL免费证书助手版本记录 - v' + SITE.version
const description =
  'TopSSL免费证书助手更新日志：查看各版本功能与改进记录。当前版本 v' + SITE.version + '，全部版本安装包见 GitHub Releases。'

const releases = [
  {
    version: 'v0.1.3',
    date: '最新版本',
    current: true,
    items: [
      '证书申请向导：输入域名即可申请，进度实时显示（端口检测 → 提交申请 → 验证 → 签发）',
      'HTTP-01 / DNS-01 两种验证方式，DNS 内置阿里云 DNS、DNSPod、Cloudflare API 自动验证',
      '通配符证书与多域名 SAN 证书支持',
      '到期前 30 天自动续期，托盘常驻 + 开机自启',
      '测试环境（Staging）与正式环境切换，不占用正式签发配额',
      '密钥经 Windows DPAPI / macOS 钥匙串 / Linux Secret Service 加密存储',
      '内置 nginx / Apache 部署配置示例',
    ],
  },
  {
    version: 'v0.1.2',
    date: '迭代版本',
    items: ['稳定性与体验优化，详细变更见 GitHub Release Notes。'],
  },
  {
    version: 'v0.1.1',
    date: '初始版本',
    items: ['项目初始化：核心证书申请、本地安装与基础管理功能。'],
  },
]
---
<BaseLayout title={title} description={description}>
  <section class="section" style="padding-top:5rem">
    <div class="container" style="max-width:56rem">
      <span class="hero-badge">更新日志</span>
      <h1 style="margin-top:1rem">更新日志</h1>
      <p class="lead" style="margin-top:.8rem">
        当前版本 <strong>v{SITE.version}</strong>。每个版本的安装包与详细变更说明见
        <a href={GITHUB + '/releases'} target="_blank" rel="noopener">GitHub Releases</a>。
      </p>

      {releases.map((r) => (
        <div class="section" style={r.current ? 'padding:2.5rem 0 1.5rem' : 'padding:1.5rem 0'}>
          <div style="display:flex;align-items:baseline;gap:.8rem;flex-wrap:wrap">
            <h2 style="margin:0">{r.version}</h2>
            <span class="hero-badge">{r.date}</span>
            {r.current && <span class="hero-badge">当前版本</span>}
          </div>
          <ul style="line-height:2;padding-left:1.2rem;margin-top:1rem">
            {r.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      ))}

      <div style="margin-top:1.5rem;display:flex;gap:.9rem;justify-content:center;flex-wrap:wrap">
        <a class="btn btn-primary" href="/download/">下载最新版本</a>
        <a class="btn btn-ghost" href="/docs/quickstart/">查看使用教程</a>
      </div>
    </div>
  </section>
</BaseLayout>
