---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import { SITE } from '../../config'

const verNums = (v: string) => v.replace(/^v/, '').split('.').map(Number)
const byDateDesc = (a: { data: { date: Date; version: string } }, b: { data: { date: Date; version: string } }) =>
  b.data.date.getTime() - a.data.date.getTime() || (() => {
    const [a1, b1] = [verNums(a.data.version), verNums(b.data.version)]
    for (let i = 0; i < Math.max(a1.length, b1.length); i++) {
      const d = (b1[i] ?? 0) - (a1[i] ?? 0)
      if (d !== 0) return d
    }
    return 0
  })()
const entries = (await getCollection('changelog')).sort(byDateDesc)
const latest = entries[0]

const title = `更新日志：Tossl免费SSL证书工具版本记录 - 最新版本 ${SITE.version}`
const description =
  `Tossl免费SSL证书申请与自动续期工具更新日志：查看各版本新增功能与修复记录。当前最新版本 ${SITE.version}，每个版本独立页面，全部安装包见下载页。`
const fmt = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`
---
<BaseLayout title={title} description={description}>
  <section class="section" style="padding-top:5rem">
    <div class="container" style="max-width:56rem">
      <nav class="crumb" aria-label="面包屑">
        <a href="/">首页</a><span>/</span><span>更新日志</span>
      </nav>
      <span class="hero-badge">更新日志 · Changelog</span>
      <h1 style="margin-top:1rem">更新日志</h1>
      <p class="lead" style="margin-top:.8rem">
        当前最新版本 <strong>v{SITE.version}</strong>。每个版本发布后，这里都会同步更新新增功能与修复记录，
        安装包见<a href="/download/">下载页</a>，代码级变更见
        <a href="https://github.com/jiachunhui/Topssl-tool-free/releases" target="_blank" rel="noopener">GitHub Releases</a>。
      </p>

      <div class="changelog-list" style="margin-top:2.5rem">
        {entries.map((e) => (
          <a class="changelog-card reveal in" href={`/changelog/${e.id}/`}>
            <div class="ver-badge">{e.data.version}</div>
            <div class="changelog-card-body">
              <h2>{e.data.title}</h2>
              <p class="changelog-meta">
                <span class="tag-chip">{fmt(e.data.date)}</span>
                {e.id === latest.id && <span class="tag-chip tag-current">最新版本</span>}
              </p>
              {e.data.description && <p class="changelog-desc">{e.data.description}</p>}
            </div>
          </a>
        ))}
      </div>

      <div style="margin-top:2.5rem;display:flex;gap:.9rem;justify-content:center;flex-wrap:wrap">
        <a class="btn btn-primary" href="/download/">下载最新版本</a>
        <a class="btn btn-ghost" href="/docs/">查看使用教程</a>
      </div>
    </div>
  </section>
</BaseLayout>
