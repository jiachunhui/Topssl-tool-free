<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 站点配置（放在站点根目录；Astro 会把 public/ 下的文件原样复制到 dist/）

  包含两项：
    1) 缓存策略
       · HTML 及未带版本标识的资源：Cache-Control: no-cache（每次带 ETag 重新验证，命中则 304）
         —— 这样部署新版本后访客立刻拿到新页面，不会停留在旧内容
       · /_astro/ 下的 CSS/JS：Astro 构建时文件名自带内容 hash，改动即换名 → 缓存 1 年
    2) 自定义 404 页面（HTTP 状态码保持 404）

  两项都已在本地 IIS 上实测：HTML 返回 no-cache、/_astro/*.css 返回 max-age=31536000、
  不存在的地址返回 404 且内容为站点 404 页。

  刻意**不包含**的配置及原因：
    · http → https、非 www → www 的强制跳转：需要 IIS URL Rewrite 模块（多数虚拟主机未安装，
      写了会整站 500）。请在主机控制面板里设置「301 重定向」或「强制 HTTPS」。
    · 移除 X-Powered-By 等响应头：纯装饰性，但 customHeaders 常被主机锁定，加了反而有整站 500 的风险。

  ⚠️ 如果上传后站点无法访问（报 500 / 500.19 / 500.49，说明某个配置节被主机锁定），
     把本文件删除即可立即恢复原状。
-->
<configuration>
  <system.webServer>

    <!-- 默认不缓存：HTML 必须每次校验，否则新版页面要等缓存过期才生效 -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <!-- 自定义 404：把静态 404.html 的内容插入错误响应，HTTP 状态码仍是 404
         必须是 responseMode="File"（静态文件）；用 "ExecuteURL" 是给动态页面
         （.asp/.aspx）的，指向静态文件时 IIS 会按其自身状态码返回 200，
         造成「软 404」——既浪费抓取配额，又可能把错误地址收录进索引。 -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="404.html" responseMode="File" />
    </httpErrors>

  </system.webServer>

  <!-- 带内容 hash 的构建产物可以长期缓存：改动会换文件名，不会拿到旧文件 -->
  <location path="_astro">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
