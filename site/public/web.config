<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 站点配置（放在站点根目录；Astro 会把 public/ 下的文件原样复制到 dist/）

  本文件只做两件低风险的事：
    1) 静态资源缓存头 —— 此前 CSS/JS/图片没有任何 Cache-Control，回访每次都要重新验证；
    2) 自定义 404 页面 —— 此前返回的是 IIS 默认错误页。

  刻意**不包含**的配置及原因：
    · http → https、非 www → www 的强制跳转：需要 IIS URL Rewrite 模块（多数虚拟主机未安装，
      写了会直接 500）。请在主机控制面板里设置「301 重定向」或「强制 HTTPS」。
    · 移除 X-Powered-By 等响应头：纯装饰性，但 customHeaders 常被主机锁定，加了反而有整站 500 的风险。

  ⚠️ 如果上传后站点无法访问（报 500 / 500.19 / 500.49，说明某个配置节被主机锁定），
     把本文件删除即可立即恢复原状。
-->
<configuration>
  <system.webServer>

    <!-- 1) 静态资源缓存：/_astro/ 下的文件名自带内容 hash，改动即换名，缓存 7 天是安全的 -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- 2) 自定义 404：返回站点自己的 404.html，HTTP 状态码仍是 404（不影响 SEO） -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

  </system.webServer>
</configuration>
