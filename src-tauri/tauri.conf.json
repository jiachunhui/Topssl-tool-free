{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SSL-Cert-Desktop",
  "version": "0.1.1",
  "identifier": "com.topsl.ssl-cert-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SSL 证书助手",
        "width": 1040,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Let's Encrypt 免费 SSL 证书一键申请",
    "longDescription": "面向普通用户的跨平台桌面程序：输入域名即可申请 Let's Encrypt 免费证书，自动安装到本机并到期自动续期。支持 HTTP/DNS 验证与通配符证书。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
